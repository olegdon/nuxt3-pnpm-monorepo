    "@devstdo/modules": "workspace:*",
    "@devstdo/services": "workspace:*",
    "@nuxt/image": "1.11.0",
    "@nuxt/kit": "4.1.3",
    "@nuxt/schema": "4.1.3",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/test-runner": "0.24.5",
    "@storybook/vue3": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "@vueuse/components": "14.4.0",
    "@vueuse/core": "14.4.0",
    "autoprefixer": "10.4.21",
    "mitt": "3.0.1",
    "pinia": "3.0.4",
    "playwright": "1.46.1",
    "postcss": "8.5.28",
    "postcss-nested": "7.0.2",
    "storybook": "10.6.0",
