    "unplugin-vue-components": "29.2.0",
    "unplugin-vue-macros": "2.14.5",
    "vite": "7.1.9",
    "vue": "3.5.42",
    "vue-i18n": "11.1.12",
    "vue-tsc": "3.1.1"
  }
